{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": ["gomod", "npm", "nvm", "dockerfile", "docker-compose", "github-actions", "helm-values", "helmv3", "custom.regex"],
  "customManagers": [
    {
      "description": "kind node image in deploy/kind/kind-config.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/kind/kind-config\\.yaml$/"],
      "matchStrings": ["image: (?<depName>kindest/node):(?<currentValue>v[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Helm CLI version used in workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["azure/setup-helm@\\S+[^\\n]*\\n\\s+with:\\n\\s+version: (?<currentValue>v\\S+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    }
  ],
  "postUpdateOptions": ["gomodTidy"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules (non-major)"
    },
    {
      "matchManagers": ["npm", "nvm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm (non-major)"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker images (non-major)"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      "matchManagers": ["helm-values", "helmv3", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Helm (non-major)"
    },
    {
      "description": "Go toolchain: bump the go directive in go.mod together with the golang build image.",
      "matchDatasources": ["golang-version"],
      "rangeStrategy": "bump"
    },
    {
      "matchDatasources": ["golang-version"],
      "groupName": "Go toolchain"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "groupName": "Go toolchain"
    },
    {
      "description": "Node.js: .nvmrc (CI) and the node build image move together.",
      "matchManagers": ["nvm"],
      "groupName": "Node.js"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "groupName": "Node.js"
    },
    {
      "description": "The chart's own image follows the chart appVersion, which the release workflow sets.",
      "matchManagers": ["helm-values"],
      "matchPackageNames": ["ghcr.io/catalinmuraru/runwarden"],
      "enabled": false
    },
    {
      "description": "TypeScript 7 (native compiler) has no JavaScript compiler API, which vue-tsc needs. Majors wait for approval on the Dependency Dashboard; approve once vue-tsc supports them.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Automerge patch updates once CI is green. A group PR only automerges if every update in it is a patch.",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
