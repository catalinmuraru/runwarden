{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": { "enum": ["gitlab", "oidc", "ldap", "none"] },
          "uniqueItems": true
        },
        "allowNoAuth": { "type": "boolean" },
        "initialAdmin": { "type": "boolean" },
        "maxFailuresPerIP": { "type": "integer", "minimum": 0 },
        "maxFailuresGlobal": { "type": "integer", "minimum": 0 },
        "publicUrl": { "type": "string" },
        "cookieSecure": { "type": ["boolean", "null"] },
        "bootstrapDevops": { "description": "removed: the built-in administrator gives the devops role" },
        "adminUsers": { "description": "removed: the built-in administrator gives the devops role" },
        "adminGroups": { "description": "removed: groups no longer grant rights" }
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$" },
              "match": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "unknownEnvironment": { "type": "string" },
        "maxExceptionDays": { "type": "integer", "minimum": 0 }
      }
    },
    "existingSecret": { "type": "string" },
    "allowedOrigins": { "type": "array", "items": { "type": "string" } },
    "trustedProxies": { "type": "array", "items": { "type": "string" } },
    "limits": {
      "type": "object",
      "properties": {
        "maxConcurrentRuns": { "type": "integer", "minimum": 1 },
        "maxRunsPerUser": { "type": "integer", "minimum": 0 }
      }
    },
    "runs": {
      "type": "object",
      "properties": {
        "home": { "enum": ["per-run", "shared"] },
        "homeSkeletonConfigMap": { "type": "string" }
      }
    },
    "valueScripts": {
      "type": "object",
      "properties": {
        "maxPerUser": { "type": "integer", "minimum": 1 },
        "maxGlobal": { "type": "integer", "minimum": 1 },
        "cacheTTL": { "type": ["string", "integer"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "egress": {
          "type": "object",
          "properties": { "dns": { "type": "boolean" }, "rules": { "type": "array" } }
        }
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "maxAge": { "type": ["string", "integer"] },
        "maxRuns": { "type": "integer", "minimum": 0 }
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "keepOnUninstall": { "type": "boolean" }
      }
    },
    "runners": {
      "type": "object",
      "properties": { "configs": { "type": "object", "additionalProperties": { "type": "object" } } }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "keepOnUninstall": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
  }
}
