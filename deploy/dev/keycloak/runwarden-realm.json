{
  "realm": "runwarden",
  "enabled": true,
  "groups": [{ "name": "ops" }],
  "clients": [
    {
      "clientId": "runwarden",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/auth/callback", "http://127.0.0.1:18089/auth/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://127.0.0.1:18089/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }],
      "groups": ["/ops"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.org",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }]
    }
  ]
}
